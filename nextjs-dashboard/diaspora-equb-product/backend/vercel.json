{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  
  "rewrites": [
    { "source": "/", "destination": "/api" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/vercel.js",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"]
    }
  ]
}
